{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "timezone": "Asia/Tokyo",
    "schedule": [
        "after 1am and before 6am on monday"
    ],
    "automergeSchedule": [
        "after 1am and before 6am on monday"
    ],
    "prHourlyLimit": 0,
    "dependencyDashboard": true,
    "autoApprove": true,
    "updateNotScheduled": false,
    "packageRules": [
        {
            "matchPackageNames": [
                "*"
            ],
            "rangeStrategy": "replace"
        },
        {
            "matchCategories": [
                "golang"
            ],
            "commitMessageAction": "Bump",
            "commitMessageExtra": "to {{newValue}}",
            "commitMessageTopic": "module {{depName}}",
            "postUpdateOptions": [
                "gomodTidy",
                "gomodUpdateImportPaths"
            ]
        },
        {
            "matchManagers": [
                "github-actions"
            ],
            "semanticCommitScope": "ci"
        },
        {
            "matchUpdateTypes": [
                "pin"
            ],
            "addLabels": [
                "renovate:pin"
            ]
        },
        {
            "matchUpdateTypes": [
                "major"
            ],
            "addLabels": [
                "renovate:major"
            ],
            "minimumReleaseAge": "7 days"
        },
        {
            "matchUpdateTypes": [
                "minor"
            ],
            "addLabels": [
                "renovate:minor"
            ],
            "minimumReleaseAge": "5 days"
        },
        {
            "matchUpdateTypes": [
                "patch"
            ],
            "addLabels": [
                "renovate:patch"
            ],
            "minimumReleaseAge": "3 days",
            "automerge": true
        },
        {
            "matchDepTypes": [
                "action"
            ],
            "pinDigests": true
        },
        {
            "groupName": "Go version",
            "matchDatasources": [
                "golang-version"
            ]
        },
        {
            "groupName": "golang.org/x/...",
            "automerge": true,
            "matchPackageNames": [
                "/^golang.org/x//"
            ]
        },
        {
            "description": "go.mod pins the ignore-deprecations branch commit (macOS Catalina build fix), but Renovate digest updates track the default branch HEAD, which is an older 2016 commit and would downgrade it",
            "matchPackageNames": [
                "github.com/99designs/go-keychain"
            ],
            "matchUpdateTypes": [
                "digest"
            ],
            "enabled": false
        }
    ],
    "customManagers": [
        {
            "customType": "regex",
            "managerFilePatterns": [
                "/.*y[a]?ml$/"
            ],
            "matchStrings": [
                "go install (?<depName>[^@]+?)@(?<currentValue>.+)\n"
            ],
            "datasourceTemplate": "go"
        },
        {
            "customType": "regex",
            "managerFilePatterns": [
                "/.*y[a]?ml$/"
            ],
            "matchStrings": [
                "golangci-lint-action@[^\n]+\n\\s+with:\n\\s+version:\\s*(?<currentValue>v[0-9.]+)"
            ],
            "depNameTemplate": "golangci/golangci-lint",
            "datasourceTemplate": "github-releases"
        }
    ],
    "vulnerabilityAlerts": {
        "enabled": true,
        "labels": [
            "renovate:security-update"
        ]
    }
}
